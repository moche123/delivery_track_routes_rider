# Copiar este archivo a .env y completar con valores reales.
# .env NO se commitea (ver .gitignore) — este .env.example sí.
#
# Expo inyecta automáticamente cualquier variable con prefijo EXPO_PUBLIC_
# en el bundle (accesible como process.env.EXPO_PUBLIC_*). No hace falta
# app.config.ts ni ningún paso extra: alcanza con tener este .env en la raíz
# de rider/ y reiniciar `expo start` para que tome cambios.

# URL del backend (Nest), usada tanto para REST como para el socket (mismo
# host:puerto, namespace /realtime). En un dispositivo físico o emulador NO
# sirve "localhost" (apunta al propio dispositivo, no a tu máquina) — usa la
# IP de tu máquina en la red local, ej: http://192.168.1.50:3000
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# Client IDs de Google OAuth, uno por plataforma (se generan en Google Cloud
# Console, tipo de credencial "iOS"/"Android"/"Web"). Son públicos por
# naturaleza (viajan igual dentro del build), no son secretos — al igual que
# GOOGLE_CLIENT_ID en client/.env (ver env_y_puertos.md en la raíz del repo).
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=TU_CLIENT_ID_IOS.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=TU_CLIENT_ID_ANDROID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=TU_CLIENT_ID_WEB.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=xxxxx.apps.googleusercontent.com